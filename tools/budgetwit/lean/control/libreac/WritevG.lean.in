      (by decide) (by decide) (by decide) (by decide))
    Hh Hlz Hc
    import_iovecs_accesses, {{package}}.Reusable.YK11.bv_eqb_refl,
    Hiok, Bool.not_true, Hent, Hmin, Hok0, Htz]

/-- A copy of `YN3g`'s private `yn3g_iov_read2`. -/
