Template for projects/<project>/rocq-<opam stem>-<project>.opam.

@@ file
# generated by oft generate from project.yaml; do not edit.
opam-version: "2.0"
name: "$package"
version: "$release"
synopsis: "Theorem statements about $project's $subject, in Rocq"
maintainer: "oss-fuzz-theorems maintainers"
license: "MIT"
homepage: "https://github.com/theorem-labs/oss-verify-proofs"
bug-reports: "https://github.com/theorem-labs/oss-verify-proofs/issues"
depends: [
  "rocq-core" {>= "$rocq_min" & < "$rocq_next"}
  "$lps_name"
  "rocq-$opam_stem-core" {= version}
]
extra-source "$bin_file" {
  src: "https://github.com/theorem-labs/oss-verify-proofs/releases/download/$bin_release/$bin_file"
  checksum: "sha256=$bin_sha256"
}
build: [
  ["mkdir" "-p" "projects/$project/bin"]
  ["tar" "--zstd" "-xf" "$bin_file" "-C" "projects/$project/bin"]
  ["./oft" "verify-sha" "$project"]
  ["dune" "build" "-p" name "-j" jobs]
]
