Template for dune-project.

@@ file
(lang dune 3.23)
(using rocq 0.13)
(name $opam_stem)
; generated by oft generate from release.yaml and projects/*/project.yaml; do not edit.
; Per available project one package for its statements and one for its proofs, the
; core and a meta package.  Each opam file is written by oft generate beside its project.

(package
 (name rocq-$opam_stem-core)
 (synopsis "The statement shapes of oss-fuzz-theorems, in Rocq")
 (license MIT)
 (depends
  (rocq-core (and (>= $rocq_min) (< $rocq_next)))
  $lps_name))

(package
 (name rocq-$opam_stem)
 (synopsis "Every package of oss-fuzz-theorems")
 (license MIT)
 (allow_empty))
$packages
@@ package
(package
 (name $name)
 (synopsis "$synopsis")
 (license MIT)
 (depends rocq-$opam_stem-core))
@@ proofs_package
(package
 (name $name)
 (synopsis "$synopsis")
 (license MIT)
 (depends rocq-$opam_stem-core)
 (allow_empty))
