Template for the dune file of each proof directory and of each proof library (proofs/<project>/<harness>/<statement>/
and proofs/<project>/<harness>/lib/, or projects/<project>/<harness>/proofs/<statement>/ and .../proofs/lib/, by
tools/oft/layout.py), and for the dune file of each per-project projects/<project>/<harness>/proofs/ and
projects/<project>/<harness>/counterexamples/ folder (barrier).

@@ file
; generated by oft generate; do not edit.
(rocq.theory
 (name $rocq)
 (package $package)
 (theories $theories))

@@ lib
; generated by oft generate; do not edit.
; The proof library of this harness: every .v file below, at any depth.
(include_subdirs qualified)
(rocq.theory
 (name $rocq)
 (package $package)
 (theories $theories))

@@ barrier
; generated by oft generate; do not edit.
; The statement theory of the folder above takes every subfolder (include_subdirs qualified).  What this folder
; holds is not part of it: each proof and the proof library have their own dune file, and dune 3.23 fails on a
; theory nested in another's subfolders.
(include_subdirs no)
