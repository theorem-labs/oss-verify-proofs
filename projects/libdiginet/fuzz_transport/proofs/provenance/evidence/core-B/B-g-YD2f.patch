+(* An image region the driver keeps across the program call also avoids the harness globals' hull
+   [G_HARNESS_B_LO, G_HARNESS_B_HI) (lib/B/TransportGB.v): the call may write G_HARNESS_B. *)
+Definition region_avoids_G (r : YP09.region) : bool :=
+match r_base r with None => ext_avoids (r_lo r) (r_hi r) (G_HARNESS_B_LO, G_HARNESS_B_HI - G_HARNESS_B_LO) | Some _ => true end.
+Lemma region_avoids_G_sound : forall r a, region_avoids_G r = true -> r_base r = None -> r_lo r <= a < r_hi r ->
+~ (G_HARNESS_B_LO <= a < G_HARNESS_B_HI).
+Proof.
+intros r a H Hb Ha. unfold region_avoids_G in H. rewrite Hb in H. unfold ext_avoids in H. cbn [fst snd] in H.
+apply orb_prop in H as [H|H]; apply Z.leb_le in H; lia.
+Qed.
+(* Every image region of the loop state avoids the harness globals' hull. `tl` drops the stack window WIN208, whose
+   base is Some 0 and which region_avoids_G passes anyway; stated over tl L_mem because that is the list YD1r walks. *)
+Lemma L_mem_avoids_G : forallb region_avoids_G (tl L_mem) = true.
+Proof. vm_compute. reflexivity. Qed.
