# site.env.example -- the SITE file regen.sh requires (SITE=<a file outside this tree>). Data only; rule 24: no
# function is proved here. Every host location and workspace name of a run is set here and nowhere in the tree: one
# NAME=value per line, no quotes; a value the caller's environment already sets wins. regen.sh refuses a SITE that
# leaves one of these unset or sets a name not listed here.
#
# Read by regen.sh itself (the kit does not see them):
# the repository that holds the internal records ref (the kit and its run records)
RECORDS_REPO=<a clone holding the internal records ref>
# the internal records ref: a commit or a ref of RECORDS_REPO that holds every file KIT-MANIFEST names (each is checked
# against its KIT-MANIFEST sha256, whatever commit it came from)
RECORDS_REF=<the internal records ref>
# the release scanner of record (the shipped-tree scan of the drivers step), in its own directory beside its
# SHA256SUMS; regen.sh pins that SHA256SUMS by sha256
SCANNER=<path of the release scanner of record>
#
# Read by the kit:
# the proofs repository checkout every step reads commits from
HUB=<a checkout of the proofs repository>
# the pinned-build root of the control units (libdiginet/fuzz_decode, libdiginet/fuzz_frame): <root>/result, <root>/unstripped
CTL_PAU=<the pinned-build root of libdiginet's control units>
# cgif_file_fuzzer's pinned asan image (the donor image of the collector and of the start chain)
CGIF_IMG=<path of cgif_file_fuzzer.asan>
# cgif's recovered names (nm -S form), the image being stripped
CGIF_NM=<path of cgif's recovered names>
# cgif's both-arms pass-2 collector log (the donor hand-off states of the start chain)
CGIF_PASS2_LOG=<path of cgif's pass-2 collector log>
# the frozen ae3i.py of reac-repacer/fuzz_uci (sha256 3cf49addef7e; internal record)
AE3I_SRC=<path of the frozen ae3i.py>
# the pinned-build root of libreac (fuzz_grant, fuzz_decode of libreac): <root>/bin, <root>/unstripped
PAU_LIBREAC=<the pinned-build root of libreac>
# the parent directory of the pinned-build roots of the control units' build pipeline
PAU_NEXT3=<the parent of the control units' pinned-build roots>
# the pinned-build root of reac-repacer (fuzz_uci, the unit of the collector control)
UCI_PAU=<the pinned-build root of reac-repacer>
# the decode reference pins of the exitdrv step: <dir>/stripped/fuzz_decode.asan and <dir>/unstripped/fuzz_decode.asan
DREF_BINS=<the directory of the decode reference binaries>
# the ASan kit's tools directory (the ELF map tool, the remap tool, the ELF reader)
KIT=<the ASan kit's tools directory>
# the kit directory that the collector packs with a build workspace
OWS_KIT=<the build kit directory>
# the directory that holds the binary-match script (read by the exitdrv step)
BINMATCH_DIR=<the binary-match scripts directory>
# the ASan options directory of the walk tools (the address-check cache, cgif's recovered names)
ASAN_OPTS_DIR=<the ASan options directory>
# the directory of the donor binaries that the address checker reads
PAC_DONORS=<the donor binaries directory>
# fuzz_uci's image-A core map.json (the ELF map of the collector control)
UCI_MAP_A9=<path of fuzz_uci's core map.json>
# fuzz_frame's image-A core map.json (the frame control of the gates)
FRAME_MAP=<path of fuzz_frame's core map.json>
# this host's temporary directory
TMPDIR=<a temporary directory>
# the directory of the lock files of the build VM's workspaces (one per workspace name)
LOCK_DIR=<a lock directory>
# the temporary directory on the build VM, inside its container
VM_TMP=<the build VM's temporary directory>
# the build launcher (clone / build of a workspace)
CB=<path of the build launcher>
# gate Gp: the name of the clone it builds in, and that clone's worktree
GP_WS=<the name of gate Gp's clone>
GP_WT=<the worktree of gate Gp's clone>
# the worker roster: a TSV whose column 1 is a worker name (gate Gn, the record step, the shipped-tree scan's control)
ROSTER=<path of the worker roster TSV>
# the build VM of the collector's four builds and of gate Gp
VM=<the build VM's name>
# the cgif donor worktree (a clone of cgif/cgif_file_fuzzer whose cgif lib is the donors' released lib)
DONOR_WT=<the donor worktree>
# the unit's build workspace name on VM (its base/stmts holds the unit's compiled images)
UNIT_WS=<the unit's build workspace name>
