     out = fopen(outfile, "wb");
     if (out == NULL) {
         perror(file);
+        gzclose(in);
         return 0;
     }
 
@@ -486,8 +496,10 @@ int LLVMFuzzerTestOneInput(const uint8_t *data, size_t dataLen) {
     break;
   }
 
-  file_compress(inFileName, outmode);
-  file_uncompress(outFileName);
