# PLANTED CONTROLS for luitrace.py: AGENT TIME (static base), TIME (plant X5), TIME (srai, jalr,
# FP move) and TIME (spill, fpjoin -- REVIEW_DIR/myplants2.py). PASS = the planted load base is
# reported by the trace (MEMBASE) AND by the may-static check; it must not be cleared as a runtime base.
# No pinned image is written: each plant goes into its own COPY.

============================================================================================================
## PLANT static-base  (Allocator::Allocate +0x560)

# plant static-base into a COPY: DECODE_A_TWIN -> planted-static-base.asan
# _ZN6__asan9Allocator8AllocateEmmPN11__sanitizer18BufferedStackTraceENS_9AllocTypeEb @0x3124c size 0x988, planted at +0x560 (vaddr 0x317ac, file offset 0x207ac)
#   +0x560  fff80337  lui t1, 0xfff80       (was 00b705b3)
#   +0x564  01035313  srli t1, t1, 0x10     (was 00010737)
#   +0x568  00000397  auipc t2, 0x0         (was 0017071b)
#   +0x56c  01038393  addi t2, t2, 0x10     (was 00160613)
#   +0x570  0063fe33  and t3, t2, t1        (was 009686b3)
#   +0x574  000e3e83  ld t4, 0(t3)          (was 00c53023)

$ python3 luitrace.py planted-static-base.asan <Allocate>      # the planted lui and its uses inside the plant
LUI	_ZN6__asan9Allocator8AllocateEmmPN11__sanitizer18BufferedSta	0x3124c	+0x560	t1	0xfffffffffff80000	b	ALU,MEMBASE
	USE	+0x564	srli t1, t1, 0x10	ALU	reg=t1	val=?	ea=-	sec=-	sym=-
	USE	+0x570	and t3, t2, t1	ALU	reg=t2,t1	val=?	ea=-	sec=-	sym=-
	USE	+0x574	ld t4, 0(t3)	MEMBASE	reg=t3	val=0x317c0	ea=0x317c0	sec=.text	sym=_ZN6__asan9Allocator8AllocateEmmPN11__sanitizer18BufferedStackTraceENS_9AllocTypeEb+0x574
#   (3 uses in total for this lui; the lines above are the ones inside the plant)

$ python3 luitrace.py static planted-static-base.asan <Allocate>   # may-static at the planted site
MAY-STATIC	_ZN6__asan9Allocator8AllocateEmmPN11__sanitizer1	+0x574	ld t4, 0(t3)	base=t3

