/projects/*/project.yaml @sjawhar @JasonGross
/projects/*/unpatched.yaml @sjawhar @JasonGross
/projects/*/patches/ @sjawhar @JasonGross
/projects/*/*/harness.yaml @sjawhar @JasonGross
/projects/*/*/Statements.v @sjawhar @JasonGross
/projects/*/*/Distribution.v @sjawhar @JasonGross
/projects/*/*/source/ @sjawhar @JasonGross
/projects/*/*/symbols/ @sjawhar @JasonGross
/projects/*/*/findings/ @sjawhar @JasonGross
/patches/ @sjawhar @JasonGross
/findings/ @sjawhar @JasonGross
/.github/ @sjawhar @JasonGross
/tools/ @sjawhar @JasonGross
/oft @sjawhar @JasonGross
