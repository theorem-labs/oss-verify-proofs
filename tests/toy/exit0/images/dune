; One rule per build: elf-snapshot turns the ELF into a memory image.  The
; outputs exist only under _build/ and are never stored.
(rule
 (targets Plain.v Plain_seg_000.hex)
 (deps (:elf ../exit0.plain))
 (action
  (run elf-snapshot %{elf} Plain.v --prefix Plain --module-name M
       --namespace OSSVerify.Tests.toy.exit0.images)))

(rule
 (targets Padded.v Padded_seg_000.hex)
 (deps (:elf ../exit0.padded))
 (action
  (run elf-snapshot %{elf} Padded.v --prefix Padded --module-name M
       --namespace OSSVerify.Tests.toy.exit0.images)))
